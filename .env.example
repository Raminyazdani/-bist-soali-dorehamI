# Server only. Connect a PRIVATE Vercel Blob store to the linked project.
# Prefer BLOB_STORE_ID with Vercel OIDC; a read/write token also works.
# Never use VITE_ names for these or commit real values.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Random server-only secret for the daily expiration cleanup.
CRON_SECRET=
